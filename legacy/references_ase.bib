@article{noauthor_testing_nodate,
	title = {Testing of {Autonomous} {Driving} {System}: {Practitioner}'s {Expectation} and {Future} {Directions}},
	volume = {1},
	abstract = {Autonomous driving has garnered significant attention in recent years. However, the associated increase in accidents has raised concerns regarding the further development of autonomous driving systems (ADSs). To address these concerns, thorough ADS testing is essential to ensure these systems can effectively handle complex driving scenarios. Although numerous testing methods and insights have been proposed and enhanced, there is a lack of synthesis on how these findings address the practical needs of industry practitioners. To bridge this gap, we conducted a large-scale survey on ADS testing. Our research began with discussions with professionals to establish an initial understanding of current practices and requirements in ADS testing. This was followed by a survey that garnered 100 responses, complemented by follow-up open-ended questions to deepen insights. Our analysis identified seven primary demands for ADS testing, one of which is concerned with the V2X system and two of which are specifically related to the use of Foundation Models (FMs) in testing processes. To understand the gaps between these demands and current practices, we reviewed relevant literature and used these findings to discuss key challenges and future research directions. This study is the first to survey the application of V2X systems and FMs in ADS testing. Our work provides a comprehensive overview of ADS testing progress and outlines potential research directions for the software engineering community. CCS Concepts: • Software and its engineering → Software testing and debugging; Software reliability.},
	language = {en},
	number = {1},
}

