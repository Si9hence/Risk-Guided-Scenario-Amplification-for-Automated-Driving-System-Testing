@inproceedings{rajan_effect_2008,
	address = {Leipzig, Germany},
	title = {The effect of program and model structure on mc/dc test adequacy coverage},
	copyright = {https://www.acm.org/publications/policies/copyright\_policy\#Background},
	isbn = {978-1-60558-079-1},
	url = {http://portal.acm.org/citation.cfm?doid=1368088.1368111},
	doi = {10.1145/1368088.1368111},
	abstract = {In avionics and other critical systems domains, adequacy of test suites is currently measured using the MC/DC metric on source code (or on a model in model-based development). We believe that the rigor of the MC/DC metric is highly sensitive to the structure of the implementation and can therefore be misleading as a test adequacy criterion. We investigate this hypothesis by empirically studying the eﬀect of program structure on MC/DC coverage.},
